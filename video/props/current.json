  "sections": [
    {
      "name": "hook",
      "text": "Which country in the Americas has the most people today?",
      "start": 0.0,
      "end": 2.461
    },
    {
      "name": "tension",
      "text": "Six countries race from 2000 to 2025. Brazil, Mexico, Canada, Argentina, Chile, and one mystery giant that starts in front.",
      "start": 2.521,
      "end": 10.091
    },
    {
      "name": "reveal",
      "text": "The USA wins with 342 million people in 2025, up from 282 million in 2000.",
      "start": 10.391,
      "end": 16.568
    },
    {
      "name": "twist",
      "text": "Brazil trails at 213 million. So which country has the most people in the Americas?",
      "start": 16.628,
      "end": 21.086
    }
  ],
