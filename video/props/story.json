 "race": true,
 "sections": [
  {
   "name": "hook",
   "text": "Which tech giant turned $1,000 into the most since 2015?",
   "start": 0,
   "end": 3.848
  },
  {
   "name": "beat1",
   "text": "In 2015 you put $1,000 into Apple, Microsoft, Nvidia, Amazon, Google and Meta.",
   "start": 3.908,
   "end": 8.791
  },
  {
   "name": "beat2",
   "text": "Apple hit $14,508 and Microsoft reached $13,765.",
   "start": 8.851,
   "end": 11.665
  },
  {
   "name": "beat3",
   "text": "Amazon did even better at $17,304, while Meta ended at $8,254.",
   "start": 11.725,
   "end": 15.918
  },
  {
   "name": "tension",
   "text": "But one stock left them all behind.",
   "start": 15.978,
   "end": 18.792
  },
  {
   "name": "reveal",
   "text": "The winner is Nvidia. It turned $1,000 into $370,774.",
   "start": 19.152,
   "end": 22.655
  },
  {
   "name": "twist",
   "text": "So which tech giant would you have picked back in 2015?",
   "start": 22.715,
   "end": 26.908
  }
 ],
